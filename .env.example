# Apple ID credentials for TestFlight upload + macOS notarization.
# Copy to .env (gitignored) and fill in.
#
# For TestFlight upload, prefer ASC API key:
#   ASC_API_KEY_ID=YOUR_KEY_ID
#   ASC_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
#   ASC_API_KEY_P8=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
# Validate these values locally without uploading:
#   source .env && VALIDATE_CREDENTIALS_ONLY=1 ./scripts/build_ios.sh
#
# Or use Apple ID + app-specific password:
#   APPLE_ID=you@apple.com
#   APPLE_PASSWORD=abcd-efgh-ijkl-mnop
#
# Apple Developer Team:
#   APPLE_TEAM_ID=DVJ6Z5343U
